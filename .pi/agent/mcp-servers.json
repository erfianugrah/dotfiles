{
  "$comment": "Tracked no-secrets MCP registry for pi (via pi-mcp-bridge). Secrets-bearing or pi-private servers go in the untracked ~/.pi/agent/mcp-bridge.json instead. Remote (HTTP) servers are NOT bridged - pi covers those with native extensions (context7, gh-search). Migrated from .config/opencode/opencode.json on 2026-08-15 when opencode was retired.",
  "mcpServers": {
    "whisper": {
      "command": ["python3", "/home/erfi/infra/ai/llm-compose/mcp/whisper-server.py"],
      "env": {
        "WHISPER_URL": "http://localhost:7860"
      }
    },
    "comfyui": {
      "command": ["python3", "/home/erfi/infra/ai/llm-compose/mcp/comfyui-server.py"],
      "env": {
        "COMFYUI_PROXY_URL": "http://localhost:11434",
        "COMFYUI_OUTPUT_DIR": "/home/erfi/docker-volumes/comfyui/output"
      }
    },
    "lora-train": {
      "command": ["python3", "/home/erfi/infra/ai/llm-compose/mcp/train-server.py"],
      "env": {
        "TRAIN_PROXY_URL": "http://localhost:11434",
        "TRAIN_OUTPUT_DIR": "/home/erfi/docker-volumes/training-data/output",
        "LORAS_DIR": "/home/erfi/docker-volumes/comfyui/models/loras"
      }
    },
    "research": {
      "command": ["python3", "/home/erfi/infra/research/mcp/research-server.py"],
      "env": {
        "SEARXNG_URL": "https://searxng.erfi.io",
        "CRAWLER_URL": "https://crawler.erfi.io",
        "OSINT_URL": "https://osint.erfi.io",
        "LLM_URL": "https://llama.erfi.io"
      }
    },
    "mnemo": {
      "command": [
        "uv",
        "run",
        "--project",
        "/home/erfi/infra/mnemosyne",
        "python",
        "/home/erfi/infra/mnemosyne/mcp/mnemo-server.py"
      ]
    },
    "mermaid": {
      "command": ["npx", "-y", "@peng-shawn/mermaid-mcp-server"],
      "env": {
        "CONTENT_IMAGE_SUPPORTED": "false"
      },
      "disabled": true
    },
    "terraform": {
      "command": ["npx", "-y", "terraform-mcp-server"],
      "disabled": true
    },
    "shadcn": {
      "command": ["npx", "-y", "shadcn-ui-mcp-server"],
      "disabled": true
    }
  }
}
