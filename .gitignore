.kube/cache
.cache
.oh-my-zsh
.config/*
!.config/atuin
!.config/cliamp
!.config/git
!.config/opencode
!.config/systemd
.config/systemd/user/*.wants
.ssh/id*
.ssh/known_hosts*

# external binaries dropped under bin/ for PATH convenience but built elsewhere
bin/knotctl

# python bytecode caches anywhere in the tree
__pycache__/
*.pyc


# JS package-manager artifacts (pi-harness / pi-loop packaging)
node_modules/
bun.lock

# vim session state - never commit (has held CF analytics token before)
.viminfo
bin/stow-drift
bin/memledger

# self-correcting-loop run artifacts - local traces, regenerated every run
.pi/harness-run.log
.pi/harness-report.json
.pi/harness-prompts/

# pi agent runtime state - per-machine, regenerated on startup; auth.json holds
# live credentials (opencode token) and must never be staged
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/ledger.db*
.pi/agent/session-fts.db*
.pi/agent/mcp-bridge.cache.json
.pi/agent/.docs-topics.json
.pi/agent/bin/
.pi/agent/git/

# Local hardware tooling (GPU fan curve), machine-specific
bin/vfcurve

# Agent worktrees (git-worktrees skill recipe)
.worktrees/
