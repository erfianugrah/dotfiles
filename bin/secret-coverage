#!/usr/bin/env bash
# secret-coverage - find secret-looking files the secretctl registry does not
# know about.
#
# The registry (~/.config/secretctl/sources) only protects stores someone
# remembered to register; an unregistered store leaks until it is added. This
# sweep turns "what I remembered" into "what exists": noseyparker scans the
# roots where credentials live, then every flagged file is run through
# `secretctl classify` in ONE call, and anything that comes back CLEAN is a
# secret-looking file outside the registry - either a store to register or a
# stray copy to delete.
#
# Nothing here prints a value. The noseyparker datastore and JSON report (which
# DO contain matched snippets) live in a private temp dir removed on exit; only
# paths and rule names are extracted from them.
#
# Exit 0 = every flagged file is covered; 1 = uncovered files listed; 2 = tool
# error. Report: $XDG_STATE_HOME/secret-coverage/last.md (plus history/).
#
# Run by the secret-coverage.timer user unit nightly; by hand: secret-coverage.
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/secret-coverage"
mkdir -p "$STATE/history"

for t in noseyparker secretctl jq; do
  command -v "$t" >/dev/null 2>&1 || { echo "secret-coverage: $t not on PATH" >&2; exit 2; }
done

# Roots: where credentials live on this box. Missing ones are skipped so the
# same script runs on every host.
CANDIDATE_ROOTS=(
  "$HOME/.config" "$HOME/infra" "$HOME/.aws" "$HOME/.docker"
  "$HOME/.netrc" "$HOME/.pgpass" "$HOME/.pi/agent/auth.json" "$HOME/.pi/agent/mcp-bridge.json"
  "$HOME/.claude.json"
)
ROOTS=()
for r in "${CANDIDATE_ROOTS[@]}"; do [ -e "$r" ] && ROOTS+=("$r"); done

WORK=$(mktemp -d "${TMPDIR:-/tmp}/secret-coverage.XXXXXX")
chmod 700 "$WORK"
trap 'rm -rf "$WORK"' EXIT INT TERM HUP

# gitignore-style excludes: transcripts and caches would flag every past leak
# and every fixture, which is noise here (the session store and the guards
# already cover them).
cat > "$WORK/ignore" <<'EOF'
# patterns are gitignore-style and match anywhere under a root
.git/
node_modules/
__pycache__/
.gomodcache/
.venv/
site-packages/
vendor/
# third-party source checkouts / vendored plugins kept under ~/infra
radarr-src/
openwrt/
Localization/
souin/plugins/
# placeholder files by convention (a real value pasted into one is still
# caught by the guards when read)
*.example
*.sample
*.template
testdata/
fixtures/
samples/
coreruleset/
*_test.go
*.test.ts
*.spec.ts
*_test.py
*.lock
*.jsonl
*.db
*.db-wal
*.db-shm
*.md
*.bak
sessions/
bg-tasks/
config-snapshots/
Code/
google-chrome/
BraveSoftware/
.cache/
EOF

noseyparker scan --datastore "$WORK/ds" --git-history=none --ignore "$WORK/ignore" \
  --max-file-size 4 "${ROOTS[@]}" >"$WORK/scan.log" 2>&1 || {
  echo "secret-coverage: noseyparker scan failed:" >&2; tail -5 "$WORK/scan.log" >&2; exit 2; }
noseyparker report --datastore "$WORK/ds" --format json >"$WORK/report.json" 2>/dev/null

# path -> rule names, never the snippet.
jq -r '.[] as $f | ($f.matches[]? | (.provenance | if type=="array" then .[] else . end | .path? // empty)) as $p
       | select($p != null) | "\($p)\t\($f.rule_name)"' "$WORK/report.json" \
  | sort -u >"$WORK/hits.tsv" || true

mapfile -t PATHS < <(cut -f1 "$WORK/hits.tsv" | sort -u)

if [ "${#PATHS[@]}" -eq 0 ]; then
  verdicts=""
else
  # One classify call resolves the registry once for every path.
  verdicts=$(secretctl classify "${PATHS[@]}" 2>/dev/null || true)
fi

uncovered=()
covered=0
for p in "${PATHS[@]}"; do
  # here-string, not a pipe: awk's early exit would SIGPIPE printf and, under
  # pipefail, abort the script with 141
  line=$(awk -v p="$p" 'index($0, p"  ")==1 {print; exit}' <<<"$verdicts")
  case "$line" in
    *"  HOLDS  "*) covered=$((covered+1)) ;;
    *) uncovered+=("$p") ;;
  esac
done

# Registered stores still in plaintext on disk (dotenv:) - a reminder, not a
# finding: the registry covers them, but they could be sops-encrypted.
plaintext=$(secretctl sources 2>/dev/null | awk '/^ +dotenv:/ {sub(/^ +/, ""); print}' || true)

{
  echo "# secret-coverage $(date -Is)"
  echo
  echo "roots: ${ROOTS[*]}"
  echo "flagged files: ${#PATHS[@]}  covered by registry: $covered  uncovered: ${#uncovered[@]}"
  echo
  if [ "${#uncovered[@]}" -gt 0 ]; then
    echo "## Uncovered (secret-looking, not a registered store, holds no registered value)"
    echo
    echo "Register the store (add a line to ~/.config/secretctl/sources) or delete the copy."
    echo
    for p in "${uncovered[@]}"; do
      rules=$(awk -F'\t' -v p="$p" '$1==p {print $2}' "$WORK/hits.tsv" | sort -u | paste -sd, -)
      echo "- \`${p/#$HOME/~}\`  ($rules)"
    done
    echo
  fi
  if [ -n "$plaintext" ]; then
    echo "## Registered but plaintext on disk (covered; consider sops)"
    echo
    printf '%s\n' "$plaintext" | sed 's/^/- /'
    echo
  fi
} >"$STATE/last.md"
cp "$STATE/last.md" "$STATE/history/$(date +%Y%m%d-%H%M%S).md"
find "$STATE/history" -type f -mtime +60 -delete 2>/dev/null || true

cat "$STATE/last.md"
[ "${#uncovered[@]}" -eq 0 ]
