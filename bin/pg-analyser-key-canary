#!/usr/bin/env bash
# Weekly canary: watch which credential the Supabase metrics endpoint accepts.
#
# Expected today (verified 2026-08-18): legacy service_role JWT -> 200,
# new-format sb_secret_ key -> 401. Two flips matter:
#   JWT -> non-200   : deprecation landed, monitoring is DOWN - fix now.
#   sb_secret_ -> 200: endpoint takes the new format - migrate keys over.
# Flips page through Alertmanager (same path as the project alerts).
set -uo pipefail

PAT=$(curl -sf --max-time 3 \
  "http://127.0.0.1:8087/list/object/items?search=SUPABASE_MGMT_PAT" \
  | jq -r '.data.data[] | select(.name == "SUPABASE_MGMT_PAT") | .notes // empty' | head -1)
[ -n "$PAT" ] || { echo "canary: vault locked - skipping" >&2; exit 1; }

REFS=$(sops -d "$HOME/infra/monitoring-compose/.env" \
  | grep '^SUPABASE_PROJECTS=' | cut -d= -f2- | tr ',' '\n' | cut -d: -f2)

alert() { # <name> <severity> <summary>
  local payload
  payload=$(jq -nc --arg n "$1" --arg s "$2" --arg m "$3" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '[{labels:{alertname:$n,severity:$s,job:"key-canary"},annotations:{summary:$m},startsAt:$t}]')
  ssh servarr "curl -sf -X POST http://172.19.40.11:9093/api/v2/alerts -H 'Content-Type: application/json' -d '$payload'" \
    && echo "ALERTED: $1 - $3"
}

rc=0
for ref in $REFS; do
  keys=$(curl -sf -H "Authorization: Bearer $PAT" \
    "https://api.supabase.com/v1/projects/$ref/api-keys")
  jwt=$(jq -r '.[] | select(.type == "legacy" and .name == "service_role") | .api_key' <<<"$keys")
  sec=$(jq -r '.[] | select(.type == "secret") | .api_key' <<<"$keys" | head -1)
  [ -n "$jwt" ] && [ -n "$sec" ] || { echo "canary: key fetch incomplete for $ref" >&2; rc=1; continue; }

  url="https://$ref.supabase.co/customer/v1/privileged/metrics"
  jwt_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -u "service_role:$jwt" "$url")
  sec_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -u "service_role:$sec" "$url")

  echo "$ref jwt=$jwt_code sb_secret=$sec_code"
  if [ "$jwt_code" != "200" ]; then
    alert SupabaseMetricsLegacyJwtRejected high \
      "metrics endpoint returned $jwt_code for the legacy service_role JWT on $ref - monitoring credential broke"
    rc=1
  fi
  if [ "$sec_code" = "200" ]; then
    alert SupabaseMetricsAcceptsSecretKeys info \
      "metrics endpoint now accepts sb_secret_ keys on $ref - migrate SUPABASE_PROJECTS off the legacy JWT"
  fi
done
exit $rc
