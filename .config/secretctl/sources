exclude JELLYFIN_PublishedServerUrl *PublishedServerUrl
exclude WAF_CADDY_ADMIN_URL *_ADMIN_URL
exclude DEFAULT_MODELS *_MODELS PGRST_OPENAPI_SERVER_PROXY_URI *_PROXY_URI GUMSHOE_URL
exclude MEMLEDGER_URL *_BASE_URL
exclude *_FILE
