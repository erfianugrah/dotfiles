# secretctl registry - the STORES credentials live in on this box.
# One source URI per line. Globs and ** apply to file paths; no #field (or #*)
# means every key in the store. dotenv:/sops: globs are content-sniffed, so the
# same pattern with both schemes puts each file in exactly one resolver.
# Read by: secretctl sources | digests | classify, and the pi secret-output-guard.
#
# Keys whose values are configuration, not credentials, wherever they appear
# (container envs especially). Excluding them only reduces masking: a digest
# of a timezone or a locale would make the guard mask ordinary output.
exclude TZ LANG LANGUAGE LC_* EMAIL PUID PGID UMASK
exclude POSTGRES_DB PGDATABASE DB_NAME *_DB_NAME DATABASE_NAME
exclude *_HOST *_HOSTNAME HOSTNAME *_PORT *_USER *_USERNAME PGUSER PGHOST PGPORT
# Bare service endpoints for self-hosted inference: configuration, not
# credentials. Listed by exact key rather than *_URL or *_API_URL on purpose -
# plenty of URLs DO carry secrets (a DSN with a password, a webhook with a
# token), so a glob here would punch a real hole in the guard. Named because
# these two collide with ~/infra/ai/llmc/AGENTS.md and made the whole
# file unreadable to agents (2026-09-07).
exclude LLM_TEXT_API_URL LLM_VISION_API_URL LLM_URL
# runtime mode flags and public key material are not credentials
exclude NODE_ENV BONKLED_ENV *_PUBLIC_KEYS *_PUBKEY SOPS_AGE_PUBLICKEY
# an access key ID is an identifier; the paired SECRET_ACCESS_KEY is the credential
exclude *_ACCESS_KEY_ID
# labels, names, tags, versions and image refs are identifiers
exclude EXEC_LABEL *_LABEL *_NAME *_TAG *_VERSION *_MODEL *_IMAGE GF_PLUGINS_PREINSTALL_SYNC GF_PLUGINS_*
# 2026-09-04: guard false positives seen in session output - db engine names, from-addresses, domains, fan-out lists are configuration
exclude *_DB_TYPE GITEA__database__DB_TYPE SMTP_FROM *_FROM GITEA_DOMAIN *_DOMAIN BONKLED_FANOUT *_FANOUT

dotenv:~/.config/*/env
dotenv:~/infra/**/.env
sops:~/infra/**/.env
sops:~/infra/**/*.enc.*
keyfile:~/.config/knotctl/keys/*.key

# Found by secret-coverage 2026-09-04: real stores that were unregistered.
dotenv:~/.aws/credentials
dotenv:~/.config/cliamp/config.toml
keyfile:~/.config/sops/age/*.txt
keyfile:~/.config/stripe-test-key
keyfile:~/infra/drawbridge/certs/*-key.pem
keyfile:~/infra/vyos-nl/config/erfi/atlas-probe/etc/probe_key
keyfile:~/infra/vyos-nl/config/erfi/pihole/etc-pihole/tls.pem
keyfile:~/infra/hearth/backup/pios-2026-08-09/home-erfi/docker-volumes/vaultwarden/vw-data/rsa_key.pem

# Remote stores: hashed on the far host, digests only (vault.RemoteAll).
# HOST/* = every running container on that host in one ssh round trip.
docker:router/*#*
docker:servarr/*#*
dotenv:~/infra/flint-openwrt/flint-secrets.env
# 2026-09-05: provider selectors (which LLM backend a service talks to) are configuration, not credentials
exclude AI_PROVIDER *_PROVIDER
exclude provider PROVIDER
exclude *_IP *_IPV4 *_IPV6 *_CIDR
# 2026-09-07: a listen address and a database ROLE NAME are configuration, not
# credentials. Both were flagging ~/infra/memledger/compose.yml as a credential
# copy (PG_EXPORTER_WEB_LISTEN_ADDRESS, PGRST_DB_ANON_ROLE), which blocked
# reading a compose file that holds no actual secret - the real ones live in
# its SOPS .env. Role names sit next to *_USER, which was already excluded.
exclude *_LISTEN_ADDRESS *_LISTEN *_BIND_ADDRESS
exclude *_ROLE *_ANON_ROLE
# 2026-09-07: runtime flags, initdb args and the in-cluster ML service URL are
# configuration too - they were flagging ~/infra/immich-compose/docker-compose.yml
# (NODE_OPTIONS, IMMICH_MACHINE_LEARNING_URL, POSTGRES_INITDB_ARGS). Kept narrow
# on purpose: NOT a blanket *_URL, because a connection URL can legitimately
# carry credentials (postgres://user:pass@host). Note the pattern behind both of
# today's additions: `docker:servarr/*#*` registers EVERY env var of every
# container, so any compose file that sets a plain config value collides. The
# exclude list is where that gets carved back, so expect to extend it.
exclude NODE_OPTIONS *_OPTIONS
exclude *_INITDB_ARGS
exclude IMMICH_MACHINE_LEARNING_URL *_MACHINE_LEARNING_URL *_ML_URL
# In-cluster service URLs (http://<container>:<port>) reached over a shared
# docker network - configuration. Listed by name rather than as `*_URL` on
# purpose: a URL-shaped key CAN carry credentials (DATABASE_URL, REDIS_URL,
# *_DSN), and a blanket exclude would stop checking those too.
exclude WEBUI_URL CRAWLER_URL OSINT_URL SEARXNG_URL GF_SERVER_ROOT_URL
# 2026-09-05: object-store endpoints and backup filter regexps are configuration (seen in compose-backups skill)
exclude *_ENDPOINT *_SERVER_URL *_EXCLUDE_REGEXP *_HEALTHCHECK_URL
exclude JELLYFIN_PublishedServerUrl *PublishedServerUrl
exclude WAF_CADDY_ADMIN_URL *_ADMIN_URL
exclude DEFAULT_MODELS *_MODELS PGRST_OPENAPI_SERVER_PROXY_URI *_PROXY_URI GUMSHOE_URL
exclude MEMLEDGER_URL *_BASE_URL
exclude *_FILE
exclude VPN_CLIENT *_CLIENT_TYPE VPN_TYPE
exclude *_LISTEN *_HEALTH_LISTEN
exclude theme THEME *_THEME
exclude *_EMAIL GMAIL
sops:~/discord-wipe-go/.env
# The file is sops-encrypted but NOT named *.enc.*, so the ~/infra/**/*.enc.*
# glob above does not reach it and it needs naming explicitly. Registered as
# secrets.enc.tfvars until 2026-09-07, which silently resolved to nothing:
# `secretctl digests` skipped the store and `classify` then called files
# holding these values CLEAN. A registry entry for a path that does not exist
# is worse than no entry, because it reads as coverage.
sops:~/infra/dns-tf/secrets.tfvars
# 2026-09-06: apt frontend env flag is configuration, not a credential (blocked ninfer Dockerfile read)
exclude DEBIAN_FRONTEND
