[Unit]
Description=Bitwarden CLI local REST API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Session file lives in /run/user/$UID (tmpfs, wiped at logout) and is only
# written by bw_serve_start after an interactive unlock. Skip cleanly when
# it's absent instead of crash-looping until someone unlocks (observed: 406
# restarts in one boot, 2026-08-13). ExecCondition, not ConditionPathExists:
# condition paths don't expand specifiers (v261), Exec* lines do.
ExecCondition=/usr/bin/test -f /run/user/%U/bw-session.env
EnvironmentFile=-%t/bw-session.env
ExecSearchPath=/usr/bin:/usr/sbin:/usr/local/bin:%h/.local/bin:%h/.nix-profile/bin
# Port must match BW_SERVE_PORT in bitwarden.zsh (default: 8087)
ExecStart=bw serve --port 8087 --hostname 127.0.0.1
Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
