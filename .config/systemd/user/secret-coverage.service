[Unit]
Description=secret-coverage - flag secret-looking files the secretctl registry does not cover
Documentation=file:%h/dotfiles/bin/secret-coverage

[Service]
Type=oneshot
ExecStart=%h/.local/bin/secret-coverage
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
# exit 1 = uncovered files listed in ~/.local/state/secret-coverage/last.md
SuccessExitStatus=1

[Install]
WantedBy=default.target
