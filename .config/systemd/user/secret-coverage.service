[Unit]
Description=secretctl coverage - flag secret-looking files the registry does not cover
Documentation=file:%h/infra/secretctl/README.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/secretctl coverage
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
# exit 1 = uncovered files listed in ~/.local/state/secretctl/coverage/last.md
SuccessExitStatus=1

[Install]
WantedBy=default.target
