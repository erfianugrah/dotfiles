[Unit]
Description=memledger quarterly restore drill

[Timer]
# Quarterly, anchored on the 2026-08-09 manual drill: Feb/May/Aug/Nov on the 9th.
# systemd's own `quarterly` shorthand would fire Jan/Apr/Jul/Oct 1st, which
# drifts off that anchor.
OnCalendar=*-02,05,08,11-09 03:00:00
# Fires on next boot if the machine was off on the 9th - a drill that only runs
# when the workstation happens to be awake at 03:00 is not a drill.
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
