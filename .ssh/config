# The bare `erfipie` alias had no HostName, so it resolved through whatever
# /etc/hosts said - and that file is WSL-generated with a stale tailnet block
# (100.69.69.6, the node from the Pi OS install, deleted 2026-08-10). ssh then
# dialled a dead address while 10.0.69.7 worked fine. Pin the name to the LAN
# address so a stale DNS/hosts record cannot silently redirect it again.
Host erfipie erfipie.manticore-diatonic.ts.net
  HostName 10.0.69.7
  User erfi
  IdentityFile ~/.ssh/id_erfipie
  IdentitiesOnly yes

# Reach it by address: LAN, or the tailnet IP of the NixOS node (re-registered
# 2026-08-10, hence the new address - the old 100.96.0.37 is gone).
Host 10.0.69.7 100.100.163.108
  User erfi
  IdentityFile ~/.ssh/id_erfipie
  IdentitiesOnly yes

