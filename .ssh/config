Host docs.erfi.io
  # docs-ssh is exposed publicly on the SG site IP (docs.erfi.io -> 118.189.189.102:2222).
  # Use the public name so this works from anywhere (incl. WSL w/o MagicDNS) - no tailscale dependency.
  HostName docs.erfi.io
  User docs
  Port 2222
  StrictHostKeyChecking accept-new
  LogLevel ERROR

